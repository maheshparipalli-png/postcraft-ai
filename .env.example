# Local development
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: use when OLLAMA_BASE_URL is behind Cloudflare Access.
# Keep these server-side only; never prefix with NEXT_PUBLIC_.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=


# Server-only Supabase key for admin operations. Never expose as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay - add when pricing and checkout are finalized.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Number of monthly billing cycles before the Razorpay subscription ends. Default: 1200.
RAZORPAY_TOTAL_COUNT=1200

# Vercel Cron authentication. Generate a long random value and set the same value in Vercel Production.
CRON_SECRET=
