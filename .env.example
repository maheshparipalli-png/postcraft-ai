# Local development
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: use when OLLAMA_BASE_URL is behind Cloudflare Access.
# Keep these server-side only; never prefix with NEXT_PUBLIC_.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=


# Server-only Supabase key for admin operations. Never expose as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional bootstrap email for the initial PostCraft super-admin.
# Prefer promoting the account in Supabase after the SaaS migration is applied.
POSTCRAFT_SUPER_ADMIN_EMAIL=

# Razorpay - add when pricing and checkout are finalized.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
